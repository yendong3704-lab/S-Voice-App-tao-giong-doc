# ============================================================================
# S-VOICE – PHÒNG THU GIỌNG ĐỌC AI & BIÊN TẬP KỊCH BẢN ĐA NGÔN NGỮ
# Khởi tạo bởi Nhà báo Đặng Sinh | Cấu hình Quỹ API Chủ sở hữu
# ============================================================================

# 1. Khóa API Gemini dành cho môi trường phát triển cục bộ (Local Dev)
# Lưu ý: Không bao giờ commit file .env hoặc .env.local lên GitHub!
VITE_GEMINI_API_KEY=""

# 2. Khóa API Gemini dành cho Serverless Proxy trên Vercel (/api/gemini)
# Khi triển khai trên Vercel, đặt biến GEMINI_API_KEY trong Vercel Project Settings
# để ẩn hoàn toàn khóa gốc khỏi trình duyệt của người dùng khách.
GEMINI_API_KEY=""

# 3. Hạn mức Bảo vệ Quỹ API Chủ sở hữu mặc định cho khách (Fair-Use Quota)
VITE_OWNER_MAX_CHARS_PER_TURN="3000"
VITE_OWNER_DAILY_QUOTA_PER_DEVICE="20"
VITE_OWNER_COOLDOWN_SECONDS="5"
